{
  "name": "@paradigm-publishing/operas-metrics-widget",
  "version": "2.0.6",
  "repository": "https://github.com/paradigm-publishing/operas-metrics-widget.git",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "assert:npm": "node scripts/assert-npm-entry.mjs",
    "assert:release": "node scripts/assert-release-notes.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm build:npm && pnpm assert:npm && pnpm assert:release",
    "dev": "vite",
    "build": "pnpm build:embed && pnpm build:npm && pnpm build:types",
    "build:embed": "vite build",
    "build:npm": "vite build --config vite.npm.config.ts",
    "build:types": "tsc -p tsconfig.types.json",
    "format": "biome format --write .",
    "lint": "biome check --fix .",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "prepare": "lefthook install",
    "prepublishOnly": "pnpm build"
  },
  "files": [
    "dist/npm",
    "LICENSE",
    "readme.md"
  ],
  "sideEffects": [
    "./dist/npm/widget.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/npm/types/src/react.d.ts",
      "import": "./dist/npm/index.mjs",
      "require": "./dist/npm/index.cjs",
      "default": "./dist/npm/index.cjs"
    },
    "./widget.css": "./dist/npm/widget.css"
  },
  "types": "./dist/npm/types/src/react.d.ts",
  "main": "./dist/npm/index.cjs",
  "module": "./dist/npm/index.mjs",
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.2",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "csstype": "^3.2.3",
    "knip": "^6.42.1",
    "lefthook": "^2.2.2",
    "preact": "^11.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "^1.105.2",
    "semantic-release": "^25.0.9",
    "typescript": "7.0.2",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.4.0",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.60.0",
    "polished": "^4.3.1",
    "topojson-client": "^3.1.0",
    "ts-deepmerge": "^8.0.0",
    "twitter-widgets": "^2.0.0",
    "world-atlas": "^2.0.2"
  }
}
